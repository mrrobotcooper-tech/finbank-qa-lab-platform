# FinBank — copiar a .env (nunca commitear .env).

APP_NAME=finbank
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKER_PORT=8001
WEB_PORT=5173
API_HOST_PORT=8000
WORKER_HOST_PORT=18001
WEB_HOST_PORT=5173
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
POSTGRES_DB=finbank
POSTGRES_USER=finbank
POSTGRES_PASSWORD=change_me
QA_READER_PASSWORD=change_me_qa
QA_DATABASE_URL=postgresql://finbank_qa_reader:change_me_qa@postgres:5432/finbank

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=25672
RABBITMQ_MANAGEMENT_HOST_PORT=25673
RABBITMQ_USER=finbank
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/

JWT_SECRET=change_me_jwt
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

CORRELATION_HEADER=X-Correlation-ID

MOCKS_HOST_PORT=8090
PAYMENT_GATEWAY_URL=http://mocks:8090
NOTIFICATION_GATEWAY_URL=http://mocks:8090

FINBANK_DEFECTS=

PROMETHEUS_PORT=9090
PROMETHEUS_HOST_PORT=9090
GRAFANA_PORT=3000
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

QA_BASE_URL=http://localhost:5173
QA_API_URL=http://localhost:8000
